# Text-to-SQL AI — Environment Variables
#
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env       (macOS / Linux)
#   copy .env.example .env     (Windows)
#
# NEVER commit your actual .env file.
# The .env file is listed in .gitignore.

# ============================================================
# Groq API Key (REQUIRED)
# ============================================================
#
# Used by the backend for:
#   - Schema-aware clarification (clarification.py)
#   - Clarification resolution (clarification_resolver.py)
#   - SQL generation (sql_generator.py)
#
# Get a free API key at: https://console.groq.com
#
# The key is loaded server-side only.
# It is never sent to the browser or stored in localStorage.

GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# PostgreSQL Database URL (REQUIRED)
# ============================================================
#
# Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local pgAdmin 4 default example:
#   postgresql://postgres:yourpassword@localhost:5432/text_to_sql_ai
#
# Cloud example (Railway, Render, Supabase, etc.):
#   postgresql://user:password@host:5432/dbname?sslmode=require
#
# This is the only place the database location is configured.
# The backend reads DATABASE_URL at startup. It is never sent
# to the browser.

DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/text_to_sql_ai

# ============================================================
# CORS Allowed Origins (REQUIRED for production)
# ============================================================
#
# Comma-separated list of origins that are allowed to call
# the API from a browser.  No wildcard origins are used.
#
# Development default (set in code if this variable is absent):
#   http://localhost:5173
#
# Production: replace with your actual deployed frontend URL.
#   CORS_ORIGINS=https://yourapp.example.com
#
# Multiple origins (e.g. www + apex):
#   CORS_ORIGINS=https://yourapp.example.com,https://www.yourapp.example.com

CORS_ORIGINS=http://localhost:5173

# ============================================================
# Rate Limiting (optional — defaults shown)
# ============================================================
#
# Controls how many requests per minute each IP address may make.
# Format: "<count>/minute"  e.g. "20/minute"
#
# LLM endpoints (/ask, /clarify) are expensive — keep low.
# SQL endpoint (/execute) is cheaper — can be slightly higher.
#
# To disable rate limiting for local development testing,
# set a very high limit such as "10000/minute".
# Do NOT disable in production.

RATE_LIMIT_ASK=20/minute
RATE_LIMIT_CLARIFY=20/minute
RATE_LIMIT_EXECUTE=60/minute
